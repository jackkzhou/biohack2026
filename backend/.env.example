# Copy to backend/.env. Never commit .env. None of these values are sent to the frontend.

# --- sensors ---
FAKE_STREAM=true                 # true = synthetic sensor data, no hardware needed
SERIAL_PORT=/dev/cu.usbserial-0001   # USB or Bluetooth serial port of the ESP32
SERIAL_BAUD=921600

# --- Tiger Data (TimescaleDB). Leave empty to run without a database. ---
TIGER_DB_URL=
STORE_RAW_STREAM=true            # also store every raw IMU sample (batched)

# --- ElevenLabs. Leave empty to disable speech. ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Learn mode ---
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en

# --- Progression prediction (Gemini). Leave key empty to disable. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_S=90
GEMINI_MAX_RETRIES=3
GEMINI_MAX_CALLS_PER_HOUR=6       # client-side cap; predictions are also cached per day
BASELINE_DAYS=14                  # consecutive days of features required before predicting

# --- server ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_BASE_URL=http://localhost:8000   # used to build the TTS audio URL sent to the browser
